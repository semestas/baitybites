# Baitybites Environment Configuration
# Copy this file to .env for local development.
# Never commit .env or place secret values in frontend files.

# Server Configuration
NODE_ENV=development
PORT=2415
HOST=localhost

# Database (Neon, Supabase, or Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/baitybites?sslmode=require

# Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_random_secret

# Application URLs
FRONTEND_URL=http://localhost:2415
BACKEND_URL=http://localhost:2415

# Production Render values:
# NODE_ENV=production
# PORT=9876
# HOST=0.0.0.0
# FRONTEND_URL=https://baitybites.vercel.app
# FRONTEND_URL=https://baitybites.netlify.app
# BACKEND_URL=https://baitybites-api.onrender.com

# Application Info
APP_NAME=Baitybites Order Management System
APP_VERSION=2.2.12

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:2415/api/auth/google/callback

# Production callback on Render:
# GOOGLE_REDIRECT_URI=https://baitybites-api.onrender.com/api/auth/google/callback

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Email provider currently used by the application: Brevo
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=id.baitybites@gmail.com
BREVO_SENDER_NAME=Baitybites

# Only set this if a separate Brevo SMTP integration is enabled.
# BREVO_SMTP_KEY=your_brevo_smtp_key

# Resend is not currently used by src/services/email.ts.
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=Baitybites <noreply@your-domain.com>

# Cloudinary image uploads
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Upload settings
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./public/uploads

# Optional Noun Project integration
# NOUN_PROJECT_KEY=your_noun_project_key
# NOUN_PROJECT_SECRET=your_noun_project_secret